# Copy this file to .dev.vars for local `wrangler pages dev` testing.
# .dev.vars is gitignored - never commit real secrets.
#
# In production these are set as Cloudflare Pages secrets (dashboard ->
# your project -> Settings -> Environment variables), not in this repo.

# JSON object, one passcode per calendar code (see functions/api/_shared/calendars.js
# for the full list of valid codes). Choose your own values - these are examples.
# Class codes are permanent slots (rec-a/rec-b = Reception's two classes, y3-a/y3-b
# = Year 3's...), NOT the class's current label: a relabelled class keeps its key.
# "whole-school" is a restricted entry - description/location editing only, see
# calendars.js's WHOLE_SCHOOL/isWholeSchoolCalendar() and tool/README.md.
CLASS_PASSWORDS={"whole-school":"changeme","rec-a":"changeme","rec-b":"changeme","y1-a":"changeme","y1-b":"changeme","y2-a":"changeme","y2-b":"changeme","y3-a":"changeme","y3-b":"changeme","y4-a":"changeme","y4-b":"changeme","y5-a":"changeme","y5-b":"changeme","y6-a":"changeme","y6-b":"changeme","fosps":"changeme"}

# Anthropic API key, used by /api/parse.
ANTHROPIC_API_KEY=sk-ant-...

# Fine-grained GitHub PAT scoped to ONLY this repo, with "Contents" and
# "Actions" permissions both set to Read and write. Used by /api/save,
# /api/events-update, /api/events-delete (Contents: commit the change;
# Actions: dispatch the "Update calendar feed" workflow so it's published in
# minutes - without Actions access saves still work, they just wait for the
# 6-hourly run).
GITHUB_TOKEN=github_pat_...
