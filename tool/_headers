# Applied by Cloudflare Pages to the tool's static files (index.html, app.js,
# style.css). It does NOT apply to /api/* responses - those get their headers
# from functions/api/_middleware.js.
#
# The tool is for class reps, not the public: keep it out of search results
# (via this header rather than robots.txt - a crawler blocked by robots.txt
# never sees a noindex), stop it being framed, and lock the page down to its own
# script, stylesheet and API. It has no inline scripts or styles, no eval, and
# talks only to its own origin, so none of that needs loosening. If you add
# any of those (a web font, an inline <style>, a third-party script), this
# policy has to change with it - tests/headers.test.mjs checks the page still
# fits it.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
