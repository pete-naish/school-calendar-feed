{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build-before-commit.sh",
            "timeout": 120,
            "statusMessage": "Rebuilding the pages' JS before commit/push…"
          }
        ]
      }
    ]
  }
}
