// The parent page and the class rep tool's page. Each .ts compiles to the .js
// beside it, which is what's served and committed (neither host runs a build) -
// run `npm run build` after editing, and commit both. CI checks they match.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "removeComments": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // ical.js's bundled types don't pass on their own. The API's shared
    // types.d.ts is still checked, by tsconfig.json.
    "skipLibCheck": true,
    "newLine": "lf"
  },
  "files": ["docs/assets/calendar.ts", "tool/app.ts", "tool/appHelpers.ts"]
}
